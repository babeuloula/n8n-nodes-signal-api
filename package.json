{
	"name": "@babeuloula/n8n-nodes-signal-api",
	"version": "0.3.1",
	"description": "Send and receive Signal messages (numbers and groups) with Signal CLI REST API",
	"license": "MIT",
	"homepage": "https://github.com/babeuloula/n8n-nodes-signal-api#readme",
	"keywords": [
		"n8n-community-node-package",
		"signal-api"
	],
	"author": {
		"name": "BaBeuloula",
		"email": "info@babeuloula.fr"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/babeuloula/n8n-nodes-signal-api.git"
	},
	"bugs": {
		"url": "https://github.com/babeuloula/n8n-nodes-signal-api/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "tsc -p tsconfig.test.json && node --test 'dist-test/test/**/*.test.js'",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SignalApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Signal/Signal.node.js",
			"dist/nodes/SignalTrigger/SignalTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.54.3",
		"@types/node": "^22.20.5",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
